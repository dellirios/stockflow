[Unit]
Description=StockFlow Label Printing Service
Wants=network-online.target cups.service
After=network-online.target cups.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=stockflow
WorkingDirectory=/home/stockflow/stockflow
Environment=NODE_ENV=production
Environment=PORT=2508
Environment=HOST=0.0.0.0
Environment=ALLOWED_STORE_KEYS=SUA_STORE_KEY
Environment=PATH=/home/stockflow/.local/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/stockflow/.local/opt/node/bin/node /home/stockflow/stockflow/src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
MemoryMax=512M

[Install]
WantedBy=multi-user.target
