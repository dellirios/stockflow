NODE_ENV=production
PORT=2508
HOST=0.0.0.0
ALLOWED_STORE_KEYS=SUA_STORE_KEY

# Legacy mode remains the default. Never copy another machine's credentials.
LONG_POLL_URL=https://stockflow.pro/start.php?store_key=SUA_STORE_KEY
ZEBRA_FEEDBACK_LOCAL_ONLY=false
PRINT_FEEDBACK_EVENTS_URL=
PRINT_FEEDBACK_TOKEN=

# Optional modern mode: enroll the device in the main system first.
# LONG_POLL_URL=https://stockflow.pro/start.php?store_key=SUA_STORE_KEY&print_feedback=1&calibration_capable=1
# ZEBRA_FEEDBACK_LOCAL_ONLY=true
# PRINT_FEEDBACK_EVENTS_URL=https://stockflow.pro/api/print-agent/events
# PRINT_FEEDBACK_TOKEN=<store-and-device-scoped-token>
# ZEBRA_USB_SERIAL=<serial-from-lsusb/sysfs>
# ZEBRA_PRINTER_NAME=<exact-CUPS-queue-name>

# One second polling is opt-in; this increases API requests.
# EMPTY_POLL_BASE_DELAY_MS=1000
# NOOP_PAYLOAD_BASE_DELAY_MS=1000
# MAX_IDLE_BACKOFF_MS=1000

# Keep automatic calibration/resume off in the verified workflow.
ZEBRA_AUTO_CALIBRATE_ENABLED=false
ZEBRA_PRECALIBRATE_BEFORE_PRINT=false
ZEBRA_RESUME_BEFORE_PRINT=false
