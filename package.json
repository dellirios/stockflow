{
  "name": "stockflow",
  "version": "2.1.0",
  "description": "Agente local de impressão ZPL e leitura QR do StockFlow Pro",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "node tests/run-regression.js",
    "test:unit": "node -e \"const r=require('./tests/printerService.test').runTests();process.exit(r.failed?1:0)\"",
    "test:elgin": "node tests/elginLabelLayout.test.js && node tests/printerGeometry.test.js",
    "preview:elgin": "node scripts/preview-elgin.js",
    "preview:elgin:watch": "node scripts/preview-elgin.js --watch",
    "test:integration": "node tests/integration.test.js",
    "test:printer": "node tests/printer-integration.test.js",
    "emulator": "node tests/printer-emulator.js",
    "dev": "NODE_ENV=development node src/app.js",
    "health": "curl -fsS http://127.0.0.1:2508/health",
    "metrics": "curl -fsS http://127.0.0.1:2508/metrics",
    "test:legacy": "node tests/run-tests.js",
    "test:zebra": "node tests/zebraLabelLayout.test.js && node tests/zebraFeedback.test.js"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.10",
    "winston": "^3.17.0"
  },
  "keywords": [
    "printing",
    "labels",
    "zebra",
    "zpl",
    "performance"
  ],
  "author": "StockFlow Team",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
