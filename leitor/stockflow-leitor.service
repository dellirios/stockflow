[Unit]
Description=StockFlow QR Code Reader Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=stockflow
WorkingDirectory=/home/stockflow/stockflow/leitor
EnvironmentFile=/home/stockflow/stockflow/leitor/leitor.env
ExecStart=/home/stockflow/stockflow/leitor/.venv/bin/python /home/stockflow/stockflow/leitor/leitor.py

# Reinicia apenas em falha real (não quando não há leitor)
Restart=on-failure
RestartSec=30s
# Desiste após 5 falhas em 10 minutos (não fica em loop infinito)
StartLimitIntervalSec=600
StartLimitBurst=5

# Limites de recursos para não consumir memória excessiva
MemoryMax=128M
CPUQuota=20%

StandardOutput=append:/home/stockflow/stockflow/logs/main.log
StandardError=append:/home/stockflow/stockflow/logs/main.log

[Install]
WantedBy=multi-user.target
